18:["$","section",null,{"className":"case-brief","aria-label":"In short","children":[["$","div","Challenge",{"children":[["$","p",null,{"className":"eyebrow","children":"Challenge"}],["$","p",null,{"children":"A world worth looking at and a real-time match against another player, with no art team and no budget for servers."}]]}],["$","div","Approach",{"children":[["$","p",null,{"className":"eyebrow","children":"Approach"}],["$","p",null,{"children":"Generate the art instead of modelling it, and let the two phones run the match between themselves."}]]}],["$","div","Result",{"children":[["$","p",null,{"className":"eyebrow","children":"Result"}],["$","p",null,{"children":"Released on the App Store — and launched with empty leaderboards, because the setup behind them was never submitted."}]]}]]}]
