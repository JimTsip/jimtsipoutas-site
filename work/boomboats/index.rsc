1b:["$","div",null,{"className":"case-pair","children":[["$","section",null,{"className":"case-section","children":[["$","p",null,{"className":"eyebrow","children":"What it is"}],["$","h2",null,{"children":"The short version"}],[["$","p","Battleship is a strategy game, which mak",{"className":"case-copy","children":"Battleship is a strategy game, which makes it a good frame for everything else: a world you want to look at, fleets with real silhouettes, power-ups you have to earn, and a match played straight between two phones."}],["$","p","The art is a pipeline, not a folder. Shi",{"className":"case-copy","children":"The art is a pipeline, not a folder. Ships, islands, trophies and the icon all come out of a toolchain, so changing a fleet is an edit rather than a week of modelling."}]],"$undefined"]}],["$","section",null,{"className":"case-section","children":[["$","p",null,{"className":"eyebrow","children":"Get it"}],["$","h2",null,{"children":"Play it yourself"}],"$undefined",["$","$L20",null,{"slug":"boomboats","download":{"appStore":"https://apps.apple.com/app/id6794503743","googlePlay":"https://play.google.com/store/apps/details?id=dev.jimtsip.boomboats","googlePlaySoon":true,"note":"Free on iPhone, in 175 countries. The Android build is in testing and follows."}}]]}]]}]
1c:["$","section",null,{"className":"case-section","children":[["$","p",null,{"className":"eyebrow","children":"Process"}],["$","h2",null,{"children":"How it was built"}],"$undefined",["$","ol",null,{"className":"case-steps","children":[["$","li","Generate the world",{"children":[["$","span",null,{"className":"case-step-no","children":"01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Generate the world"}],["$","p",null,{"children":"Every asset comes out of a toolchain rather than a modelling session, which is how the art scales without an art team."}],null]}]]}],["$","li","Let the two phones settle it",{"children":[["$","span",null,{"className":"case-step-no","children":"02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Let the two phones settle it"}],["$","p",null,{"children":"The match runs directly between the players, with the defending side judging each shot — which closes the obvious way to cheat."}],null]}]]}],["$","li","Make power-ups cost something",{"children":[["$","span",null,{"className":"case-step-no","children":"03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Make power-ups cost something"}],["$","p",null,{"children":"Levels offer them; credits buy them. Separating the two stopped the economy giving away its own content."}],null]}]]}],["$","li","Ship honestly on each platform",{"children":[["$","span",null,{"className":"case-step-no","children":"04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ship honestly on each platform"}],["$","p",null,{"children":"Android cannot run the real-time match, so the screens say so rather than the store listing overselling it."}],null]}]]}]]}]]}]
