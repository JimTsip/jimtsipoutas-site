e:["$","div",null,{"className":"case-pair","children":[["$","section",null,{"className":"case-section","children":[["$","p",null,{"className":"eyebrow","children":"What it is"}],["$","h2",null,{"children":"The short version"}],[["$","p","Battleship is a strategy game, which mak",{"className":"case-copy","children":"Battleship is a strategy game, which makes it a good frame for everything else: a world you want to look at, fleets with real silhouettes, power-ups you have to earn, and a match played straight between two phones."}],["$","p","The art is a pipeline, not a folder. Shi",{"className":"case-copy","children":"The art is a pipeline, not a folder. Ships, islands, trophies and the icon all come out of a toolchain, so changing a fleet is an edit rather than a week of modelling."}]],"$undefined"]}],["$","section",null,{"className":"case-section","children":[["$","p",null,{"className":"eyebrow","children":"Get it"}],["$","h2",null,{"children":"Play it yourself"}],"$undefined",["$","$L13",null,{"slug":"boomboats","download":{"appStore":"https://apps.apple.com/app/id6794503743","googlePlay":"https://play.google.com/store/apps/details?id=dev.jimtsip.boomboats","googlePlaySoon":true,"note":"Free on iPhone, in 175 countries. The Android build is in testing and follows."}}]]}]]}]
