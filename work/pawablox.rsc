12:["$","section",null,{"className":"case-section","children":[["$","p",null,{"className":"eyebrow","children":"Decisions"}],["$","h2",null,{"children":"What was chosen, and what it cost"}],"$undefined",["$","div",null,{"className":"case-decisions","children":[["$","article","Foundations before a visible component library",{"children":[["$","h3",null,{"children":"Foundations before a visible component library"}],["$","dl",null,{"children":[["$","div",null,{"children":[["$","dt",null,{"children":"Over"}],["$","dd",null,{"children":"Having something to show in the first month"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Because"}],["$","dd",null,{"children":"A library on unstable foundations locks the inconsistency in, and every fix after that means moving everything again."}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"It cost"}],["$","dd",null,{"children":"Weeks with nothing to demo. That is a plan you have to defend twice."}]]}]]}]]}],["$","article","A system people could build with",{"children":[["$","h3",null,{"children":"A system people could build with"}],["$","dl",null,{"children":[["$","div",null,{"children":[["$","dt",null,{"children":"Over"}],["$","dd",null,{"children":"A design-only library with the usual handoff"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Because"}],["$","dd",null,{"children":"It changes who is able to make something. Ideas stopped being described and started being built."}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"It cost"}],["$","dd",null,{"children":"A second surface to keep in sync, deliberately and on a schedule."}]]}]]}]]}]]}]]}]
