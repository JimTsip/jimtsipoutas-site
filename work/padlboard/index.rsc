f:["$","div",null,{"className":"$undefined","children":[["$","section",null,{"className":"case-section","children":[["$","p",null,{"className":"eyebrow","children":"What it is"}],["$","h2",null,{"children":"The short version"}],[["$","p","Padel is scored by people holding a rack",{"className":"case-copy","children":"Padel is scored by people holding a racket. Every app I tried assumed you would stop playing, look at a phone and tell it who won. PadlBoard is one tap — games, sets, tiebreaks and history all follow from it."}],["$","p","It is three surfaces on one product: the",{"className":"case-copy","children":"It is three surfaces on one product: the watch on court, the phone for the match, the web for everything after. The hard part was not the app. It was replacing everything underneath it while people were using it."}]],"$undefined"]}],null]}]
10:["$","section",null,{"className":"case-section","children":[["$","p",null,{"className":"eyebrow","children":"Process"}],["$","h2",null,{"children":"How it was built"}],"$undefined",["$","ol",null,{"className":"case-steps","children":[["$","li","Cut the work into steps that can be checked",{"children":[["$","span",null,{"className":"case-step-no","children":"01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Cut the work into steps that can be checked"}],["$","p",null,{"children":"Every piece went to an agent as something small enough to verify before the next one started. The discipline is not the prompting; it is refusing to move on until a step is proven."}],null]}]]}],["$","li","Design the interaction, then the product",{"children":[["$","span",null,{"className":"case-step-no","children":"02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Design the interaction, then the product"}],["$","p",null,{"children":"An eyes-free version tested worse than it read on paper and was dropped. Tap the team that won survived because it needs no instruction."}],null]}]]}],["$","li","One product, three surfaces",{"children":[["$","span",null,{"className":"case-step-no","children":"03"}],["$","div",null,{"children":[["$","h3",null,{"children":"One product, three surfaces"}],["$","p",null,{"children":"The watch, the phone and the web are views on the same match, not three apps kept in sync with each other."}],null]}]]}],["$","li","Rebuild without taking the product down",{"children":[["$","span",null,{"className":"case-step-no","children":"04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Rebuild without taking the product down"}],["$","p",null,{"children":"Everything underneath was replaced in stages, and nothing switched over until the checks passed on a clean copy — which is why the change was invisible to the people using it."}],null]}]]}]]}]]}]
11:["$","div",null,{"className":"case-close","children":[["$","section",null,{"className":"case-section","children":[["$","p",null,{"className":"eyebrow","children":"Outcome"}],["$","h2",null,{"children":"Where it landed"}],[["$","p","Live on the App Store in Greek and Engli",{"className":"case-copy","children":"Live on the App Store in Greek and English. The rebuild went out as version 1.1 and was deliberately left out of the release notes, because it was never a customer feature."}]],"$undefined"]}],["$","section",null,{"className":"case-section","children":[["$","p",null,{"className":"eyebrow","children":"Lesson"}],["$","h2",null,{"children":"What it cost me to learn"}],[["$","p","Agents are not faster because they type ",{"className":"case-copy","children":"Agents are not faster because they type faster. They are faster when the work is cut into steps that can each be proven finished — and slower than doing it by hand when it is not."}]],"$undefined"]}]]}]
