 on the App Store in Greek and English, with the rebuild shipped as an ordinary update customers never had to notice."}]]}]]}],["$","section",null,{"className":"case-metrics","aria-label":"Key numbers","children":[["$","div","surfaces, one product",{"children":[["$","strong",null,{"children":"3"}],["$","span",null,{"children":"surfaces, one product"}],["$","em",null,{"children":"watch, phone, web"}]]}],"$Lc","$Ld"]}],"$Le","$Lf","$L10","$L11","$L12"]}]}],"$L13"]}]
