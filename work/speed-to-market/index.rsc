1f:["$","section",null,{"className":"case-section","children":[["$","p",null,{"className":"eyebrow","children":"My role"}],["$","h2",null,{"children":"Who did what"}],"$undefined",["$","div",null,{"className":"case-split","children":[["$","div",null,{"children":[["$","h3",null,{"children":"Mine"}],["$","ul",null,{"children":[["$","li","Decided where AI belonged: two points, not everywhere.",{"children":"Decided where AI belonged: two points, not everywhere."}],["$","li","Made the design system the base for prototyping, so what people build behaves like the product.",{"children":"Made the design system the base for prototyping, so what people build behaves like the product."}],["$","li","Set up the loop — test with customers, iterate, then release to a small live audience.",{"children":"Set up the loop — test with customers, iterate, then release to a small live audience."}],["$","li","Kept judgement human. AI shortens the distance; it does not decide.",{"children":"Kept judgement human. AI shortens the distance; it does not decide."}]]}]]}],["$","div",null,{"children":[["$","h3",null,{"children":"The team’s"}],["$","ul",null,{"children":[["$","li","Product managers build their own prototypes and own the ideas they take to customers.",{"children":"Product managers build their own prototypes and own the ideas they take to customers."}],["$","li","Research defined what a valid test looks like, so speed did not quietly become sloppiness.",{"children":"Research defined what a valid test looks like, so speed did not quietly become sloppiness."}],["$","li","Engineering owns the release mechanics that make a small live rollout safe and reversible.",{"children":"Engineering owns the release mechanics that make a small live rollout safe and reversible."}]]}]]}]]}]]}]
20:["$","section",null,{"className":"case-section","children":[["$","p",null,{"className":"eyebrow","children":"Process"}],["$","h2",null,{"children":"How it went"}],"$undefined",[["$","ol",null,{"className":"case-steps","children":[["$","li","Prototype on the real system",{"children":[["$","span",null,{"className":"case-step-no","children":"01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Prototype on the real system"}],["$","p",null,{"children":"Product people assemble something from the real components, so it behaves like the product instead of describing it — in hours, not in a sprint. Being wrong costs nothing at that price."}],null]}]]}],["$","li","Ask customers, not the room",{"children":[["$","span",null,{"className":"case-step-no","children":"02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ask customers, not the room"}],["$","p",null,{"children":"Usability testing with real customers. That is the whole reason the prototype has to be built on the real system."}],null]}]]}],["$","li","Iterate while it is still cheap",{"children":[["$","span",null,{"className":"case-step-no","children":"03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Iterate while it is still cheap"}],["$","p",null,{"children":"Another round costs hours. The second and third versions are the ones customers actually asked for."}],null]}]]}],["$","li","Release to a slice first",{"children":[["$","span",null,{"className":"case-step-no","children":"04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Release to a slice first"}],["$","p",null,{"children":"A prototype tells you whether people understand something. Only production tells you whether they do it."}],null]}]]}]]}],["$","figure",null,{"className":"case-diagram","children":["$","div",null,{"className":"case-diagram-panels","children":[["$","div",null,{"className":"case-diagram-panel","children":[["$","p",null,{"className":"eyebrow","children":"Before"}],["$","svg",null,{"viewBox":"0 0 3