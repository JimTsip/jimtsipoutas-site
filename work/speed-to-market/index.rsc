1e:["$","section",null,{"className":"case-section","children":[["$","p",null,{"className":"eyebrow","children":"The problem"}],["$","h2",null,{"children":"What was actually wrong"}],[["$","p","Most of the time between an idea and a r",{"className":"case-copy","children":"Most of the time between an idea and a release is not spent building. It is spent deciding what to build, and then finding out late that it was the wrong thing."}],["$","p","Here that happened in documents, and cus",{"className":"case-copy","children":"Here that happened in documents, and customers only saw the idea once engineering had committed to it — which makes every finding expensive and every disagreement political."}]],["$","figure",null,{"className":"case-diagram","children":["$","div",null,{"className":"case-diagram-panels","children":[["$","div",null,{"className":"case-diagram-panel","children":[["$","p",null,{"className":"eyebrow","children":"Before"}],["$","svg",null,{"viewBox":"0 0 320 200","role":"img","aria-label":"A one-way line from a brief to a PRD to a Slack thread to a build, with the answer arriving last.","children":[["$","line",null,{"x1":"40","y1":33.333333333333336,"x2":"40","y2":166.66666666666669,"className":"spine"}],null,[["$","g","A brief",{"children":[["$","circle",null,{"cx":"40","cy":33.333333333333336,"r":"6","className":"node"}],["$","text",null,{"x":"62","y":37.333333333333336,"children":"A BRIEF"}]]}],["$","g","A long-form PRD",{"children":[["$","circle",null,{"cx":"40","cy":66.66666666666667,"r":"6","className":"node"}],["$","text",null,{"x":"62","y":70.66666666666667,"children":"A LONG-FORM PRD"}]]}],["$","g","A Slack thread",{"children":[["$","circle",null,{"cx":"40","cy":100,"r":"6","className":"node"}],["$","text",null,{"x":"62","y":104,"children":"A SLACK THREAD"}]]}],["$","g","Build it",{"children":[["$","circle",null,{"cx":"40","cy":133.33333333333334,"r":"6","className":"node"}],["$","text",null,{"x":"62","y":137.33333333333334,"children":"BUILD IT"}]]}