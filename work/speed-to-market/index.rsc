21:["$","section",null,{"className":"case-section","children":[["$","p",null,{"className":"eyebrow","children":"Decisions"}],["$","h2",null,{"children":"What was chosen, and what it cost"}],"$undefined",["$","div",null,{"className":"case-decisions","children":[["$","article","Two points, not everywhere",{"children":[["$","h3",null,{"children":"Two points, not everywhere"}],["$","dl",null,{"children":[["$","div",null,{"children":[["$","dt",null,{"children":"Over"}],["$","dd",null,{"children":"Rolling AI out across the whole process at once"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Because"}],["$","dd",null,{"children":"Speed is governed by how fast an idea becomes testable and how fast the answer comes back. The rest can wait."}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"It cost"}],["$","dd",null,{"children":"Saying no to a long list of reasonable-sounding requests."}]]}]]}]]}],["$","article","Prototypes built by whoever had the idea",{"children":[["$","h3",null,{"children":"Prototypes built by whoever had the idea"}],["$","dl",null,{"children":[["$","div",null,{"children":[["$","dt",null,{"children":"Over"}],["$","dd",null,{"children":"Prototypes built by designers on request"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Because"}],["$","dd",null,{"children":"A prototype you made yourself is one you will happily throw away. A queue turns the author into a reviewer of their own thinking."}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"It cost"}],["$","dd",null,{"children":"The design system has to be genuinely good, because it is now used by people who cannot work around its gaps."}]]}]]}]]}],["$","article","A live slice before the full audience",{"children":[["$","h3",null,{"children":"A live slice before the full audience"}],["$","dl",null,{"children":[["$","div",null,{"children":[["$","dt",null,{"children":"Over"}],["$","dd",null,{"children":"Deciding on the strength of the usability test alone"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Because"}],["$","dd",null,{"children":"Only real money in a real market shows what people actually do, rather than what they understand."}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"It cost"}],["$","dd",null,{"children":"Release mechanics, monitoring, and a real willingness to pull something back."}]]}]]}]]}]]}]]}]
22:["$","div",null,{"className":"case-close","children":[["$","section",null,{"className":"case-section","children":[["$","p",null,{"className":"eyebrow","children":"Outcome"}],["$","h2",null,{"children":"What came of it"}],[["$","p","The loop closes inside the product inste",{"className":"case-copy","children":"The loop closes inside the product instead of in a meeting: build, test with customers, iterate, release to a slice."}],["$","p","Product stopped queuing for design time ",{"className":"case-copy","children":"Product stopped queuing for design time to explore an idea, and design stopped making artefacts for ideas that were never going to survive a customer."}],["$","p","Direction and accountability stayed huma",{"className":"case-copy","children":"Direction and accountability stayed human. AI made the distance shorter, not the decisions."}]],"$undefined"]}],["$","section",null,{"className":"case-section","children":[["$","p",null,{"className":"eyebrow","children":"Lesson"}],["$","h2",null,{"children":"What it cost me to learn"}],[["$","p","The failure mode is looping instead of l",{"className":"case-copy","children":"The failure mode is looping instead of learning, and it feels productive the whole time it is happening. A loop only pays when something outside the team answers at the end of it."}]],"$undefined"]}]]}]
