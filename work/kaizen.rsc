14:["$","section",null,{"className":"case-section","children":[["$","p",null,{"className":"eyebrow","children":"Process"}],["$","h2",null,{"children":"How it went"}],"$undefined",[["$","ol",null,{"className":"case-steps","children":[["$","li","Name the standard before hiring",{"children":[["$","span",null,{"className":"case-step-no","children":"01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Name the standard before hiring"}],["$","p",null,{"children":"Career expectations and a shared definition of quality first, then leads mentored to hold them — otherwise growth just multiplies inconsistency, and the function stops at what one person can review."}],null]}]]}],["$","li","Make critique a ritual",{"children":[["$","span",null,{"className":"case-step-no","children":"02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Make critique a ritual"}],["$","p",null,{"children":"A recurring, structured critique with rules about what is being asked for. Feedback stops depending on who is in the room."}],null]}]]}],["$","li","Move decisions off opinion",{"children":[["$","span",null,{"className":"case-step-no","children":"03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Move decisions off opinion"}],["$","p",null,{"children":"Research alongside experimentation, so a disagreement resolves into a test rather than into seniority."}],null]}]]}],["$","li","Share patterns across products",{"children":[["$","span",null,{"className":"case-step-no","children":"04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Share patterns across products"}],["$","p",null,{"children":"Reusable patterns and shared standards raise quality everywhere at once, instead of product by product."}],null]}]]}]]}],["$","figure",null,{"className":"case-diagram","children":["$","div",null,{"className":"case-diagram-panels","children":[["$","div",null,{"className":"case-diagram-panel","children":[["$","p",null,{"className":"eyebrow","children":"Before"}],["$","svg",