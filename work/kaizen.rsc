,"dt",null,{"children":"Because"}],["$","dd",null,{"children":"Local optimisation across many teams produces something that feels like several products."}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"It cost"}],["$","dd",null,{"children":"Teams lose some autonomy, and the system has to earn it back by being faster to use than to ignore."}]]}]]}]]}]]}]]}]
