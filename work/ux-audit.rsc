e:["$","section",null,{"className":"case-brief","aria-label":"In short","children":[["$","div","Challenge",{"children":[["$","p",null,{"className":"eyebrow","children":"Challenge"}],["$","p",null,{"children":"Everyone knew the basic UX problems. Nothing recorded them, so they never competed for the roadmap and nobody could say whether the experience was improving."}]]}],["$","div","Approach",{"children":[["$","p",null,{"className":"eyebrow","children":"Approach"}],["$","p",null,{"children":"Walk the journeys that matter on the live product, judge every finding against a named principle, and rank it by severity."}]]}],["$","div","Result",{"children":[["$","p",null,{"className":"eyebrow","children":"Result"}],["$","p",null,{"children":"The whole product reviewed in days instead of a quarter, ending in one prioritised list that design, product and tech work through together."}]]}]]}]
