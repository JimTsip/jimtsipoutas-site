11:["$","section",null,{"className":"case-section","children":[["$","p",null,{"className":"eyebrow","children":"The problem"}],["$","h2",null,{"children":"What was actually wrong"}],[["$","p","Every product carries a layer of problem",{"className":"case-copy","children":"Every product carries a layer of problems everyone has met and nobody has written down: the confusing step in registration, the error message that explains nothing, the button you keep missing."}],["$","p","With no record they never reach a planni",{"className":"case-copy","children":"With no record they never reach a planning meeting, and quality stays an opinion — which loses every argument against a feature that has a number attached to it."}]],["$","figure",null,{"className":"case-diagram","children":["$","div",null,{"className":"case-diagram-panels","children":[["$","div",null,{"className":"case-diagram-panel","children":[["$","p",null,{"className":"eyebrow","children":"Before"}],["$","svg",null,{"viewBox":"0 0 320 200","role":"img","aria-label":"A UX problem is noticed, mentioned, and then goes nowhere.","children":[["$","line",null,{"x1":"40","y1":40,"x2":"40","y2":160,"className":"spine"}],null,[["$","g","A problem exists",{"children":[["$","circle",null,{"cx":"40","cy":40,"r":"6","className":"node"}],["$","text",null,{"x":"62","y":44,"children":"A PROBLEM EXISTS"}]]}],["$","g","Someone trips over it",{"children":[["$","circle",null,{"cx":"40","cy":80,"r":"6","className":"node"}],["$","text",null,{"x":"62","y":84,"children":"SOMEONE TRIPS OVER IT"}]]}],["$","g","It gets mentioned",{"children":[["$","circle",null,{"cx":"40","cy":120,"r":"6","className":"node"}],["$","text",null,{"x":"62","y":124,"children":"IT GETS MENTIONED"}]]}],["$","g","Nowhere",{"children":[["$","circle",null,{"cx":"40","cy":160,"r":"6","className":"node dead"}],["$","text",null,{"x":"62","y":164,"children":"NOWHERE"}]]}]]]}],["$","figcaption",null,{"children":"Known to whoever met it, recorded nowhere, so it never reached a planning meeting."}]]}],["$","div",null,{"className":"case-diagram-panel","children":[["$","p",null,{"className":"eyebrow","children":"After"}],["$","svg",null,{"viewBox":"0 0 320 200","role":"img","aria-label":"A UX problem is caught by the monthly audit, reported, prioritised, fixed, and confirmed by the next report.","children":[["$","line",null,{"x1":"40","y1":40,"x2":"40","y2":160,"className":"spine"}],[["$","path",null,{"d":"M 40 160 C 6 160, 6 40, 32 40","className":"return"}],["$","path",null,{"d":"M 27 35 L 32 40 L 27 45","className":"return arrow"}]],[["$","g","The audit finds it",{"children":[["$","circle",null,{"cx":"40","cy":40,"r":"6","className":"node"}],["$","text",null,{"x":"62","y":44,"children":"THE AUDIT FINDS IT"}]]}],["$","g","It lands in the report",{"children":[["$","circle",null,{"cx":"40","cy":80,"r":"6","className":"node"}],["$","text",null,{"x":"62","y":84,"children":"IT LANDS IN THE REPORT"}]]}],["$","g","It competes for priority",{"children":[["$","circle",null,{"cx":"40","cy":120,"r":"6","className":"node"}],["$","text",null,{"x":"62","y":124,"children":"IT COMPETES FOR PRIORITY"}]]}],["$","g","Fixed and confirmed",{"children":[["$","circle",null,{"cx":"40","cy":160,"r":"6","className":"node"}],["$","text",null,{"x":"62","y":164,"children":"FIXED AND CONFIRMED"}]]}]]]}],["$","figcaption",null,{"children":"On the record, in front of the executive team, competing like anything else."}]]}]]}]}]]}]
12:["$","section",null,{"className":"case-section","children":[["$","p",null,{"className":"eyebrow","children":"My role"}],["$","h2",null,{"children":"Who did what"}],"$undefined",["$","div",null,{"className":"case-split","children":[["$","div",null,{"children":[["$","h3",null,{"children":"Mine"}],["$","ul",null,{"children":[["$","li","Defined what gets reviewed, what it is judged against, and what a finding must contain before it counts.",{"children":"Defined what gets reviewed, what it is judged against, and what a finding must contain before it counts."}],["$","li","Chose known usability laws as the standard, so every finding cites a principle rather than a preference.",{"children":"Chose known usability laws as the standard, so every finding cites a principle rather than a preference."}],["$","li","Picked the journeys by value — registration, payments, navigation — not by how easy they are to test.",{"children":"Picked the journeys by value — registration, payments, navigation — not by how easy they are to test."}],["$","li","Insisted on reviewing the live product, where customers actually are.",{"children":"Insisted on reviewing the live product, where customers actually are."}],["$","li","Made the output a ranked roadmap the teams work through, not a report that gets read once.",{"children":"Made the output a ranked roadmap the teams work through, not a report that gets read once."}]]}]]}],["$","div",null,{"children":[["$","h3",null,{"children":"The team’s"}],["$","ul",null,{"children":[["$","li","Design owns the findings in their areas and decides what a good fix looks like.",{"children":"Design owns the findings in their areas and decides what a good fix looks like."}],["$","li","Product weighs them against everything else competing for the roadmap.",{"children":"Product weighs them against everything else competing for the roadmap."}],["$","li","Tech closes them, and the next review says whether the fix held.",{"children":"Tech closes them, and the next review says whether the fix held."}]]}]]}]]}]]}]
13:["$","section",null,{"className":"case-section","children":[["$","p",null,{"className":"eyebrow","children":"Process"}],["$","h2",null,{"children":"How it went"}],"$undefined",[["$","ol",null,{"className":"case-steps","children":[["$","li","Pick journeys by value",{"children":[["$","span",null,{"className":"case-step-no","children":"01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pick journeys by value"}],["$","p",null,{"children":"Registration, payments, navigation — where the money and the frustration are, and on the live product rather than on staging, because the difference between the two is the problems nobody has recorded."}],null]}]]}],["$","li","Judge against a named principle",{"children":[["$","span",null,{"className":"case-step-no","children":"02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Judge against a named principle"}],["$","p",null,{"children":"Every finding cites a known usability law, so a designer, a product manager and an engineer argue on the same ground."}],null]}]]}],["$","li","Record what works, too",{"children":[["$","span",null,{"className":"case-step-no","children":"03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Record what works, too"}],["$","p",null,{"children":"A review that only collects faults reads as an attack on the team that built it, and gets defended against instead of acted on."}],null]}]]}],["$","li","End in a ranked roadmap",{"children":[["$","span",null,{"className":"case-step-no","children":"04"}],["$","div",null,{"children":[["$","h3",null,{"children":"End in a ranked roadmap"}],["$","p",null,{"children":"Severity turns the findings into one prioritised list across the product — a plan, not a verdict."}],null]}]]}]]}],["$","figure",null,{"className":"case-diagram","children":["$","div",null,{"className":"case-diagram-panels","children":[["$","div",null,{"className":"case-diagram-panel","children":[["$","p",null,{"className":"eyebrow","children":"A list of problems"}],["$"