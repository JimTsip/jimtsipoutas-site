.scene-status{z-index:18;color:var(--muted);pointer-events:none;font-family:var(--mono);letter-spacing:.16em;align-items:center;gap:10px;font-size:8px;transition:opacity .22s,transform .22s;display:flex;position:fixed;bottom:26px;left:clamp(22px,4.4vw,70px)
.scene-status i{background:var(--signal);width:6px;height:6px;box-shadow:0 0 18px var(--signal);border-radius:50%
.hero-panel,.chapter-panel,.contact-panel{min-height:100svh;padding-left:clamp(22px,8vw,128px);padding-right:clamp(60px,9vw,148px)
.eyebrow{color:var(--glow);font-family:var(--mono);letter-spacing:.2em;text-transform:uppercase;margin:0 0 24px;font-size:9px
.hero-panel{flex-direction:column;justify-content:center;padding-top:115px;padding-bottom:60px;display:flex
.hero-panel h1{max-width:1120px;font-family:var(--display);letter-spacing:-.072em;flex-direction:column;gap:.141em;margin:0;font-size:clamp(70px,11.8vw,170px);font-weight:400;line-height:.76;display:flex
.hero-panel h1 em{font-style:italic;font-weight:500
.hero-panel h1 em,.chapter-panel h2 em,.contact-heading h2 em{color:var(--signal);font-weight:400
.hero-bottom{grid-template-columns:minmax(280px,560px) auto;align-items:end;gap:50px;margin-top:clamp(18px,1.67vw,24px);display:grid
.hero-bottom>p{color:#ebf1ffad;margin:0;font-size:clamp(16px,1.25vw,18px);line-height:1.62
.chapter-panel{grid-template-columns:54px minmax(0,720px);align-items:center;gap:clamp(22px,4vw,64px);display:grid
.chapter-right{text-align:right;grid-template-columns:minmax(0,720px) 54px;justify-content:end
.chapter-right .chapter-index{order:2
.chapter-right .chapter-content{order:1;align-items:flex-end
.chapter-index{color:var(--signal);font-family:var(--mono);letter-spacing:.18em;writing-mode:vertical-rl;font-size:9px
.chapter-content{flex-direction:column;display:flex
.chapter-panel h2{max-width:760px;font-family:var(--display);letter-spacing:-.056em;margin:0;font-size:clamp(54px,7.4vw,112px);font-weight:400;line-height:.88
.chapter-copy{color:#ebf1ffad;max-width:530px;margin:28px 0 0;font-size:clamp(15px,1.24vw,19px);line-height:1.62
.chapter-right .chapter-copy{margin-left:auto
.contact-panel{flex-direction:column;justify-content:center;align-items:center;gap:0;min-height:138svh;padding-top:130px;padding-bottom:110px;display:flex;position:relative
.contact-heading{text-align:center;width:min(1020px,100%)
.contact-heading h2{font-family:var(--display);letter-spacing:-.07em;margin:0;font-size:clamp(68px,9.7vw,150px);font-weight:400;line-height:.8
.contact-form{text-align:left;width:min(1040px,100%);box-shadow:none;background:0 0;border:1px solid #07163457;margin-top:62px;padding:0
.contact-form label{border-bottom:1px solid #07163445;flex-direction:column;gap:14px;padding:clamp(24px,2.8vw,38px);display:flex
.contact-form .form-grid label:nth-child(odd){border-right:1px solid #07163445
.contact-form label>span{color:#071634;font-family:var(--mono);letter-spacing:.2em;text-transform:uppercase;font-size:8px;font-weight:700
.contact-form input,.contact-form select,.contact-form textarea{color:#071634;width:100%;font-family:var(--display);background:0 0;border:0;border-radius:0;outline:none;padding:0;font-size:clamp(22px,2.1vw,32px);line-height:1.15;transition:color .18s,opacity .18s
.contact-form textarea{resize:vertical;min-height:124px
.contact-form select{-webkit-appearance:none;appearance:none;cursor:pointer
.contact-form option{color:var(--paper);background:#07102b
.contact-form input::placeholder,.contact-form textarea::placeholder{color:#0716346b
.contact-form input:focus,.contact-form select:focus,.contact-form textarea:focus{color:#fff
.contact-footer{color:var(--muted);font-family:var(--mono);letter-spacing:.13em;text-transform:uppercase;justify-content:space-between;font-size:8px;display:flex;position:absolute;bottom:30px;left:clamp(22px,4.4vw,70px);right:clamp(22px,4.4vw,70px)
.scene-status{bottom:16px;left:18px
.hero-panel,.chapter-panel,.contact-panel{padding-left:18px;padding-right:48px
.hero-panel{justify-content:flex-start;padding-top:126px;padding-bottom:48px
.hero-panel .eyebrow{max-width:330px;margin-bottom:28px;font-size:8px;line-height:1.55
.hero-panel h1{letter-spacing:-.06em;gap:.06em;max-width:100%;font-size:clamp(58px,19vw,82px);line-height:.82
.hero-bottom{grid-template-columns:1fr;gap:26px;margin-top:42px
.hero-bottom>p{max-width:340px;font-size:16px;line-height:1.56
.chapter-panel,.chapter-right{text-align:left;grid-template-columns:26px minmax(0,1fr);gap:10px
.chapter-right .chapter-index,.chapter-right .chapter-content{order:initial
.chapter-right .chapter-content{align-items:flex-start
.chapter-panel h2{font-size:clamp(48px,15vw,76px)
.chapter-right .chapter-copy{margin-left:0
.contact-panel{align-items:flex-start;min-height:160svh
.contact-heading{text-align:left
.contact-heading h2{font-size:clamp(62px,18vw,96px)
.contact-form{margin-top:44px;padding:0
.contact-form .form-grid label:nth-child(odd){border-right:0
.contact-form label,.form-action{padding:22px
.contact-footer{flex-direction:column;gap:8px;left:18px;right:18px
.chat-launcher{z-index:42;-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);color:var(--paper);cursor:pointer;font-family:var(--mono);letter-spacing:.2em;text-transform:uppercase;isolation:isolate;text-shadow:0 0 14px #9ec2ff8c;background:linear-gradient(#14224eeb,#050814eb);border:1px solid #7ea6ff8c;border-radius:999px;align-items:center;gap:12px;padding:18px 32px;font-size:11.5px;transition:transform .2s,border-color .2s,box-shadow .24s;animation:3.4s ease-in-out infinite chat-neon;display:flex;position:fixed;bottom:clamp(18px,3vw,32px);left:50%;overflow:hidden;transform:translate(-50%);box-shadow:0 0 0 1px #4d7cff2e,0 0 22px #4d7cff61,0 0 54px #4d7cff38,inset 0 1px #cfe1ff38
.chat-launcher:before{content:"";z-index:-1;background:linear-gradient(105deg,#0000 38%,#9ec2ff47 50%,#0000 62%);animation:4.6s ease-in-out infinite chat-sheen;position:absolute;inset:0;transform:translate(-120%)
.chat-launcher:hover{border-color:#bed6ffd9;transform:translate(-50%)translateY(-2px);box-shadow:0 0 0 1px #4d7cff66,0 0 34px #4d7cffb3,0 0 90px #4d7cff66,inset 0 1px #cfe1ff4d
.chat-launcher span{white-space:nowrap
.chat-launcher i{background:var(--glow);border-radius:50%;flex:none;width:7px;height:7px;animation:2.6s ease-out infinite chat-pulse;box-shadow:0 0 10px 2px #9ec2ffe6
.chat-launcher.is-open{text-shadow:none;background:#050814eb;border-color:#acc6ff66;animation:none;box-shadow:0 0 0 1px #4d7cff1f
.chat-launcher.is-open:before{opacity:0;animation:none
.chat-launcher.is-open i{background:var(--muted);box-shadow:none;animation:none
.chat-dock{z-index:41;border:1px solid var(--line);-webkit-backdrop-filter:blur(20px);backdrop-filter:blur(20px);opacity:0;pointer-events:none;background:#050814e6;flex-direction:column;width:min(392px,100vw - 32px);max-height:min(600px,100svh - 64px);margin-left:calc(min(392px,100vw - 32px)/-2);transition:opacity .22s,transform .22s;display:flex;position:fixed;bottom:calc(clamp(18px,3vw,32px) + 74px);left:50%;transform:translateY(14px)scale(.98)
.chat-dock.is-open{opacity:1;pointer-events:auto;transform:none
.chat-head{border-bottom:1px solid var(--line);justify-content:space-between;align-items:center;gap:12px;padding:16px 18px;display:flex
.chat-head p{color:var(--paper);font-family:var(--mono);letter-spacing:.2em;text-transform:uppercase;margin:0;font-size:12px
.chat-head p span{color:var(--muted)
.chat-head button{color:var(--muted);cursor:pointer;background:0 0;border:0;font-size:13px;line-height:1
.chat-head button:hover{color:var(--paper)
.chat-log{overscroll-behavior:contain;flex-direction:column;flex:1;gap:14px;padding:18px;display:flex;overflow-y:auto
.chat-chips{flex-direction:column;gap:8px;display:flex
.chat-chips button{border:1px solid var(--line);color:var(--glow);cursor:pointer;font-family:var(--sans);text-align:left;background:0 0;padding:11px 14px;font-size:13px;line-height:1.4;transition:border-color .18s,color .18s
.chat-chips button:hover{color:var(--paper);border-color:#acc6ff8c
.chat-msg{white-space:pre-wrap;max-width:90%;font-size:14.5px;line-height:1.62
.chat-user{color:var(--paper);background:#4d7cff1f;border:1px solid #4d7cff6b;align-self:flex-end;padding:10px 14px
.chat-assistant{color:#ebf1ffdb;align-self:flex-start
.chat-msg a{color:var(--glow);border-bottom:1px solid #acc6ff73;text-decoration:none;transition:color .16s,border-color .16s
.chat-msg a:hover{color:var(--paper);border-color:var(--paper)
.chat-qr-block{border-top:1px solid var(--line);align-items:center;gap:12px;margin-top:14px;padding-top:14px;display:flex
.chat-qr-block span{color:var(--muted);font-family:var(--mono);letter-spacing:.14em;text-transform:uppercase;font-size:9px;line-height:1.5
.chat-qr{border-radius:2px;flex:none;width:74px;height:74px
.chat-caret{background:var(--signal);vertical-align:-2px;width:7px;height:14px;margin-left:3px;animation:1s steps(2,end) infinite chat-blink;display:inline-block
.chat-thinking{gap:5px;display:flex
.chat-thinking i{background:var(--muted);border-radius:50%;width:5px;height:5px;animation:1.2s ease-in-out infinite chat-bounce
.chat-thinking i:nth-child(2){animation-delay:.15s
.chat-thinking i:nth-child(3){animation-delay:.3s
.chat-error{color:#ff8e9b;margin:0;font-size:13px;line-height:1.55
.chat-input{border-top:1px solid var(--line);align-items:center;gap:10px;padding:14px 16px;display:flex
.chat-input input:disabled{opacity:.5;cursor:not-allowed
.chat-input input{min-width:0;color:var(--paper);font-family:var(--sans);background:0 0;border:0;outline:none;flex:1;font-size:14.5px
.chat-input input::placeholder{color:#e5edff6b
.chat-input button{border:1px solid var(--line);color:var(--paper);cursor:pointer;font-family:var(--mono);letter-spacing:.16em;text-transform:uppercase;background:0 0;padding:9px 14px;font-size:9px;transition:background .18s,color .18s
.chat-input button:hover:not(:disabled){background:var(--paper);color:var(--ink)
.chat-input button:disabled{opacity:.4;cursor:not-allowed
.chat-head{touch-action:none;padding:20px 10px 10px 20px;position:relative
.chat-head:before{content:"";background:#acc6ff4d;border-radius:2px;width:38px;height:4px;margin-left:-19px;position:absolute;top:8px;left:50%
.chat-head button{justify-content:center;align-items:center;width:44px;height:44px;font-size:17px;display:flex
.chat-log{padding:18px 20px
.chat-chips button{padding:15px 16px;font-size:14px
.chat-input{padding:10px 12px 10px 20px
.chat-input input{font-size:16px
.chat-input button{padding:14px 16px
.chat-launcher.is-open{display:none
.chat-launcher{letter-spacing:.16em;gap:10px;max-width:calc(100vw - 36px);padding:16px 24px;font-size:10.5px
.chat-intro{color:var(--muted);margin:0;font-size:14px;line-height:1.62
